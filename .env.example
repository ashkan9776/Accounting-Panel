# =========================================================================
# پیکربندی متغیرهای محیطی پلتفرم ابری حسابداری ایرانی (Production & Dev)
# =========================================================================

# محیط اجرا (development / production / test)
NODE_ENV=production
PORT=3000

# مسیر فایل ذخیره‌سازی دیتابیس SQLite
DATABASE_PATH=storage/accounting.db

# کلید رمزنگاری نشست‌ها و توکن‌های JWT
JWT_SECRET=AccountingSaaS_UltraSecureKey_Iran_2026_Compliant!
JWT_EXPIRES_IN=7d

# اتصال به سامانه مودیان مالیاتی کشور (Tax Administration API)
MOADIAN_BASE_URL=https://tp.tax.gov.ir/req/api
MOADIAN_PRIVATE_KEY_PATH=/etc/accounting/moadian_private_key.pem
MOADIAN_CERTIFICATE_PATH=/etc/accounting/moadian_cert.pem

# درگاه پرداخت اینترنتی شاپرک (IPG)
SHAPARAK_MERCHANT_ID=MID-9821-IRAN-001
SHAPARAK_TERMINAL_ID=TERM-ONLINE-01
SHAPARAK_VERIFY_URL=https://sep.shaparak.ir/verify

# وب‌سرویس ناوگان پیک و تحویل فوری (اسنپ‌باکس / الوپیک)
SNAPPBOX_API_KEY=sb_live_secret_token_1403
ALOPEYK_API_KEY=alopeyk_api_token_ir

# سرویس پیامک اطلاع‌رسانی و احراز هویت (کاوانگار / مگفا)
SMS_PROVIDER=KAVENEGAR
SMS_API_KEY=kavenegar_api_key_iran_accounting
